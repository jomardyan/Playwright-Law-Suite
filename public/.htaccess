# UniVerscan landing page - Apache config for shared hosting (OVH).
# This is a fully static export: there is no PHP and no Node runtime here.

DirectoryIndex index.html

# --- HTTPS and canonical host ------------------------------------------------
# OVH terminates TLS upstream, so mod_rewrite sees http; X-Forwarded-Proto is
# the reliable signal. Comment this block out until the certificate is issued,
# or the first visit redirects into a certificate warning.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Serve /docs as /docs/ so the directory index is found. The export uses
  # trailingSlash, so every route is a directory containing index.html.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Caching -----------------------------------------------------------------
# Next emits content-hashed filenames under /_next/static, so those are
# immutable. HTML must not be cached hard, or a redeploy is invisible.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Security headers ------------------------------------------------------
  # The page loads no third-party scripts, fonts or analytics, so the policy
  # can be strict. 'unsafe-inline' on style-src is required because Next
  # inlines critical CSS into the document.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- 404 ---------------------------------------------------------------------
ErrorDocument 404 /404.html
