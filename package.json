{
  "name": "universcan",
  "version": "0.3.0",
  "description": "UniVerscan - Universal Playwright Web Compliance Scanner",
  "license": "MIT",
  "type": "module",
  "bin": {
    "universcan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config",
    "require-shim.cjs",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "postinstall:browsers": "playwright install --with-deps chromium",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "axe-core": "^4.10.0",
    "commander": "^12.1.0",
    "fast-xml-parser": "^4.5.0",
    "js-yaml": "^4.1.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "compliance",
    "accessibility",
    "gdpr",
    "privacy",
    "wcag",
    "playwright",
    "scanner",
    "a11y",
    "cookies",
    "sarif"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomardyan/Playwright-Law-Suite.git"
  },
  "homepage": "https://github.com/jomardyan/Playwright-Law-Suite#readme",
  "bugs": {
    "url": "https://github.com/jomardyan/Playwright-Law-Suite/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./require-shim.cjs"
    },
    "./package.json": "./package.json"
  }
}
