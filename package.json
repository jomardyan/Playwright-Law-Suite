{
  "name": "universcan",
  "version": "0.1.0",
  "description": "UniVerscan - Universal Playwright Web Compliance Scanner",
  "license": "MIT",
  "type": "module",
  "bin": {
    "universcan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "commander": "^12.1.0",
    "fast-xml-parser": "^4.5.0",
    "js-yaml": "^4.1.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
